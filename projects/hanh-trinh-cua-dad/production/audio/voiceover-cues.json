    {"id":"VO_C007","scene_id":"S01_SH03","start_frame":344,"end_frame_exclusive":390,"text":"Rồi Dad sang Việt Nam.","file":"VO_C007_S01_SH03.wav"},
    {"id":"VO_C008","scene_id":"S01_SH03","start_frame":408,"end_frame_exclusive":470,"text":"Mục tiêu tiếp theo: con trâu.","file":"VO_C008_S01_SH03.wav"},
    {"id":"VO_C009","scene_id":"S01_SH03","start_frame":540,"end_frame_exclusive":564,"text":"May mà...","file":"VO_C009_S01_SH03.wav"},
    {"id":"VO_C010","scene_id":"S01_SH03","start_frame":564,"end_frame_exclusive":604,"text":"chuyện thật hay hơn.","file":"VO_C010_S01_SH03.wav","audio_bridge_into_next_scene":true},

    {"id":"VO_C011","scene_id":"S02_SH01","start_frame":604,"end_frame_exclusive":684,"text":"Chuyện thật bắt đầu ở Adelaide, Nam Úc.","file":"VO_C011_S02_SH01.wav"},
    {"id":"VO_C012","scene_id":"S02_SH01","start_frame":684,"end_frame_exclusive":744,"text":"Nơi Dad sống và làm việc.","file":"VO_C012_S02_SH01.wav"},

    {"id":"VO_C013","scene_id":"S02_SH02","start_frame":756,"end_frame_exclusive":792,"text":"Dad hỏi Sơ Nien:","file":"VO_C013_S02_SH02.wav"},
    {"id":"VO_C014","scene_id":"S02_SH02","start_frame":796,"end_frame_exclusive":900,"text":"Làm sao để sinh viên không phải bỏ học vì nghèo?","file":"VO_C014_S02_SH02.wav"},

    {"id":"VO_C015","scene_id":"S02_SH03","start_frame":924,"end_frame_exclusive":1070,"text":"Năm 1996, Dad đi qua Cao Bằng, Bắc Cạn, Lạng Sơn và Hạ Long.","file":"VO_C015_S02_SH03.wav"},
    {"id":"VO_C016","scene_id":"S02_SH04","start_frame":1088,"end_frame_exclusive":1210,"text":"Dad gặp anh Đoàn Minh Nam, lúc đó là hướng dẫn viên.","file":"VO_C016_S02_SH04.wav"},

    {"id":"VO_C017","scene_id":"S03_SH01","start_frame":1232,"end_frame_exclusive":1304,"text":"Năm 1997, Dad quay lại Việt Nam.","file":"VO_C017_S03_SH01.wav"},
    {"id":"VO_C018","scene_id":"S03_SH01","start_frame":1310,"end_frame_exclusive":1380,"text":"Học bổng bắt đầu thành hình.","file":"VO_C018_S03_SH01.wav"},

    {"id":"VO_C019","scene_id":"S03_SH02","start_frame":1400,"end_frame_exclusive":1456,"text":"Tại SunWay, Hà Nội,","file":"VO_C019_S03_SH02.wav"},
    {"id":"VO_C020","scene_id":"S03_SH02","start_frame":1456,"end_frame_exclusive":1560,"text":"Dad và anh Nam bàn: giúp ai, bao nhiêu, chọn thế nào.","file":"VO_C020_S03_SH02.wav"},

    {"id":"VO_C021","scene_id":"S03_SH03","start_frame":1560,"end_frame_exclusive":1664,"text":"Qua Cha Nguyễn Văn Tuyến, sinh viên khó khăn được giới thiệu.","file":"VO_C021_S03_SH03.wav"},
    {"id":"VO_C022","scene_id":"S03_SH03","start_frame":1664,"end_frame_exclusive":1742,"text":"Anh Nam phiên dịch, ghi chép.","file":"VO_C022_S03_SH03.wav"},

    {"id":"VO_C023","scene_id":"S03_SH04","start_frame":1760,"end_frame_exclusive":1848,"text":"Nhóm đầu tiên Dad hỗ trợ có tám sinh viên.","file":"VO_C023_S03_SH04.wav"},
    {"id":"VO_C024","scene_id":"S03_SH04","start_frame":1852,"end_frame_exclusive":1908,"text":"Không phải tám nghìn. Tám.","file":"VO_C024_S03_SH04.wav"},

    {"id":"VO_C025","scene_id":"S04_SH01","start_frame":1930,"end_frame_exclusive":2048,"text":"Tên đầu tiên là Stevenson Scholarship Programme.","file":"VO_C025_S04_SH01.wav"},
    {"id":"VO_C026","scene_id":"S04_SH02","start_frame":2070,"end_frame_exclusive":2126,"text":"Dad ở Australia.","file":"VO_C026_S04_SH02.wav"},
    {"id":"VO_C027","scene_id":"S04_SH02","start_frame":2130,"end_frame_exclusive":2184,"text":"Anh Nam ở Việt Nam.","file":"VO_C027_S04_SH02.wav"},

    {"id":"VO_C028","scene_id":"S04_SH03","start_frame":2190,"end_frame_exclusive":2316,"text":"Từ 1997 đến 2006, số sinh viên được hỗ trợ tăng dần.","file":"VO_C028_S04_SH03.wav"},
    {"id":"VO_C029","scene_id":"S04_SH04","start_frame":2334,"end_frame_exclusive":2436,"text":"Bạn bè và cộng đồng nối thêm những cánh tay.","file":"VO_C029_S04_SH04.wav"},

    {"id":"VO_C030","scene_id":"S05_SH01","start_frame":2448,"end_frame_exclusive":2564,"text":"Năm 2006, anh Nam chuyển giao công việc cho Nguyễn Hoàng Cung.","file":"VO_C030_S05_SH01.wav"},
    {"id":"VO_C031","scene_id":"S05_SH02","start_frame":2568,"end_frame_exclusive":2664,"text":"Cũng năm đó, chương trình mang tên Viet Uc Family.","file":"VO_C031_S05_SH02.wav"},

    {"id":"VO_C032","scene_id":"S05_SH03","start_frame":2664,"end_frame_exclusive":2710,"text":"Không chỉ tiền.","file":"VO_C032_S05_SH03.wav"},
    {"id":"VO_C033","scene_id":"S05_SH03","start_frame":2710,"end_frame_exclusive":2768,"text":"Còn niềm tin và hi vọng.","file":"VO_C033_S05_SH03.wav"},
