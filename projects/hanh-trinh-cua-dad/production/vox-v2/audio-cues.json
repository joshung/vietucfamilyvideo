{
  "schema_version": "2.0",
  "project_id": "VUF_DAD_001",
  "fps": 24,
  "sample_rate_hz": 48000,
  "global_audio_offset_frames": 0,
  "cue_count": 24,
  "policy": "one independent cue per 5-second shot window; cue overflow fails locally and never shifts later cues",
  "cues": [
    {
      "id": "B01_VO_A",
      "local_start_frame": 0,
      "local_end_frame_exclusive": 112,
      "text": "Đây là Dad Stevenson, một người Úc sống và làm việc ở Adelaide.",
      "beat_id": 1,
      "shot_id": "1a",
      "global_start_frame": 0,
      "global_end_frame_exclusive": 112,
      "file": "B01_VO_A.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B01_VO_B",
      "local_start_frame": 120,
      "local_end_frame_exclusive": 232,
      "text": "Và không, câu chuyện này không bắt đầu bằng kangaroo.",
      "beat_id": 1,
      "shot_id": "1b",
      "global_start_frame": 120,
      "global_end_frame_exclusive": 232,
      "file": "B01_VO_B.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B02_VO_A",
      "local_start_frame": 0,
      "local_end_frame_exclusive": 112,
      "text": "Ở Adelaide, Dad trao đổi với Sơ Nien về một câu hỏi rất thật.",
      "beat_id": 2,
      "shot_id": "2a",
      "global_start_frame": 240,
      "global_end_frame_exclusive": 352,
      "file": "B02_VO_A.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B02_VO_B",
      "local_start_frame": 120,
      "local_end_frame_exclusive": 232,
      "text": "Làm sao để sinh viên giỏi không phải dừng học vì thiếu tiền?",
      "beat_id": 2,
      "shot_id": "2b",
      "global_start_frame": 360,
      "global_end_frame_exclusive": 472,
      "file": "B02_VO_B.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B03_VO_A",
      "local_start_frame": 0,
      "local_end_frame_exclusive": 112,
      "text": "Năm 1996, Dad đi qua Cao Bằng, Bắc Cạn, Lạng Sơn và Hạ Long.",
      "beat_id": 3,
      "shot_id": "3a",
      "global_start_frame": 480,
      "global_end_frame_exclusive": 592,
      "file": "B03_VO_A.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B03_VO_B",
      "local_start_frame": 120,
      "local_end_frame_exclusive": 232,
      "text": "Ở đó, Dad gặp Đoàn Minh Nam, khi ấy là hướng dẫn viên.",
      "beat_id": 3,
      "shot_id": "3b",
      "global_start_frame": 600,
      "global_end_frame_exclusive": 712,
      "file": "B03_VO_B.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B04_VO_A",
      "local_start_frame": 0,
      "local_end_frame_exclusive": 112,
      "text": "Một năm sau, Dad quay lại Việt Nam.",
      "beat_id": 4,
      "shot_id": "4a",
      "global_start_frame": 720,
      "global_end_frame_exclusive": 832,
      "file": "B04_VO_A.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B04_VO_B",
      "local_start_frame": 120,
      "local_end_frame_exclusive": 232,
      "text": "Tại SunWay, Hà Nội, họ bàn: giúp ai, bao nhiêu, chọn thế nào.",
      "beat_id": 4,
      "shot_id": "4b",
      "global_start_frame": 840,
      "global_end_frame_exclusive": 952,
      "file": "B04_VO_B.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B05_VO_A",
      "local_start_frame": 0,
      "local_end_frame_exclusive": 112,
      "text": "Sơ Nien và Cha Nguyễn Văn Tuyến giúp kết nối sinh viên khó khăn.",
      "beat_id": 5,
      "shot_id": "5a",
      "global_start_frame": 960,
      "global_end_frame_exclusive": 1072,
      "file": "B05_VO_A.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B05_VO_B",
      "local_start_frame": 120,
      "local_end_frame_exclusive": 232,
      "text": "Anh Nam phiên dịch, ghi lại chuyện học, gia đình, quê quán, dự định.",
      "beat_id": 5,
      "shot_id": "5b",
      "global_start_frame": 1080,
      "global_end_frame_exclusive": 1192,
      "file": "B05_VO_B.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B06_VO_A",
      "local_start_frame": 0,
      "local_end_frame_exclusive": 112,
      "text": "Nhóm đầu tiên có tám sinh viên. Không phải tám nghìn. Tám.",
      "beat_id": 6,
      "shot_id": "6a",
      "global_start_frame": 1200,
      "global_end_frame_exclusive": 1312,
      "file": "B06_VO_A.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B06_VO_B",
      "local_start_frame": 120,
      "local_end_frame_exclusive": 232,
      "text": "Một con số nhỏ, nhưng đủ để biến một ý tưởng thành việc thật.",
      "beat_id": 6,
      "shot_id": "6b",
      "global_start_frame": 1320,
      "global_end_frame_exclusive": 1432,
      "file": "B06_VO_B.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B07_VO_A",
      "local_start_frame": 0,
      "local_end_frame_exclusive": 112,
      "text": "Hỗ trợ không chỉ là học phí.",
      "beat_id": 7,
      "shot_id": "7a",
      "global_start_frame": 1440,
      "global_end_frame_exclusive": 1552,
      "file": "B07_VO_A.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B07_VO_B",
      "local_start_frame": 120,
      "local_end_frame_exclusive": 232,
      "text": "Có thể là chỗ ở, sách, đi lại, y tế, hoặc giúp gia đình.",
      "beat_id": 7,
      "shot_id": "7b",
      "global_start_frame": 1560,
      "global_end_frame_exclusive": 1672,
      "file": "B07_VO_B.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B08_VO_A",
      "local_start_frame": 0,
      "local_end_frame_exclusive": 112,
      "text": "Tên đầu tiên là Stevenson Scholarship Programme.",
      "beat_id": 8,
      "shot_id": "8a",
      "global_start_frame": 1680,
      "global_end_frame_exclusive": 1792,
      "file": "B08_VO_A.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B08_VO_B",
      "local_start_frame": 120,
      "local_end_frame_exclusive": 232,
      "text": "Dad ở Australia. Anh Nam ở Việt Nam. Cây cầu ấy bắt đầu chạy.",
      "beat_id": 8,
      "shot_id": "8b",
      "global_start_frame": 1800,
      "global_end_frame_exclusive": 1912,
      "file": "B08_VO_B.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B09_VO_A",
      "local_start_frame": 0,
      "local_end_frame_exclusive": 112,
      "text": "Từ 1997 đến 2006, số sinh viên được hỗ trợ tăng dần.",
      "beat_id": 9,
      "shot_id": "9a",
      "global_start_frame": 1920,
      "global_end_frame_exclusive": 2032,
      "file": "B09_VO_A.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B09_VO_B",
      "local_start_frame": 120,
      "local_end_frame_exclusive": 232,
      "text": "Mạng lưới mở rộng qua bạn bè, cộng đồng, sinh viên và đại học.",
      "beat_id": 9,
      "shot_id": "9b",
      "global_start_frame": 2040,
      "global_end_frame_exclusive": 2152,
      "file": "B09_VO_B.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B10_VO_A",
      "local_start_frame": 0,
      "local_end_frame_exclusive": 112,
      "text": "Năm 2006, anh Nam chuyển giao công việc cho Nguyễn Hoàng Cung.",
      "beat_id": 10,
      "shot_id": "10a",
      "global_start_frame": 2160,
      "global_end_frame_exclusive": 2272,
      "file": "B10_VO_A.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B10_VO_B",
      "local_start_frame": 120,
      "local_end_frame_exclusive": 232,
      "text": "Cùng năm đó, chương trình mang tên Viet Uc Family.",
      "beat_id": 10,
      "shot_id": "10b",
      "global_start_frame": 2280,
      "global_end_frame_exclusive": 2392,
      "file": "B10_VO_B.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B11_VO_A",
      "local_start_frame": 0,
      "local_end_frame_exclusive": 112,
      "text": "Quan trọng nhất: hỗ trợ vô điều kiện, không phải trả nợ.",
      "beat_id": 11,
      "shot_id": "11a",
      "global_start_frame": 2400,
      "global_end_frame_exclusive": 2512,
      "file": "B11_VO_A.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B11_VO_B",
      "local_start_frame": 120,
      "local_end_frame_exclusive": 232,
      "text": "Không phân biệt tôn giáo, dân tộc, ngành học hay giới.",
      "beat_id": 11,
      "shot_id": "11b",
      "global_start_frame": 2520,
      "global_end_frame_exclusive": 2632,
      "file": "B11_VO_B.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B12_VO_A",
      "local_start_frame": 0,
      "local_end_frame_exclusive": 112,
      "text": "Và khi có thể, người đi trước lại giúp người đi sau.",
      "beat_id": 12,
      "shot_id": "12a",
      "global_start_frame": 2640,
      "global_end_frame_exclusive": 2752,
      "file": "B12_VO_A.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    },
    {
      "id": "B12_VO_B",
      "local_start_frame": 120,
      "local_end_frame_exclusive": 232,
      "text": "Đó là tinh thần Dad để lại: Dream. Believe. Do.",
      "beat_id": 12,
      "shot_id": "12b",
      "global_start_frame": 2760,
      "global_end_frame_exclusive": 2872,
      "file": "B12_VO_B.wav",
      "format": "wav_pcm_s16le_mono_48000hz"
    }
  ]
}
