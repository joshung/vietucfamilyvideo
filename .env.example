# VietUcFamilyVideo — example configuration only.
# Copy to .env locally. NEVER commit the real .env.

# ---------- Canonical media storage ----------
MEDIA_STORAGE_PROVIDER=r2
MEDIA_STORAGE_ROOT=projects

# Cloudflare R2 / S3-compatible example
S3_ENDPOINT=
S3_BUCKET=vietucfamilyvideo
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Optional human-review mirror ----------
REVIEW_STORAGE_PROVIDER=google_drive
GDRIVE_ROOT_FOLDER_ID=
# Prefer secret injection / mounted credential file; do not commit credentials.
GDRIVE_CREDENTIALS_FILE=

# ---------- Project ----------
PROJECT_ID=VUF_DAD_001
PROJECT_SLUG=hanh-trinh-cua-dad

# ---------- AI video provider ----------
# Routing is defined in project docs. Keys stay local/secret.
AI_VIDEO_PROVIDER=runway
RUNWAY_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1

# ---------- Render execution ----------
RENDER_CONCURRENCY=2
MAX_GENERATION_ATTEMPTS_PER_SHOT=4
# Optional hard ceiling. Leave blank to disable.
MAX_RENDER_COST_USD=
RENDER_POLL_INTERVAL_SECONDS=10
RENDER_JOB_TIMEOUT_SECONDS=1800
ALLOW_BILLABLE_SMOKE_TEST=false

# ---------- Upload policy ----------
UPLOAD_RAW_ATTEMPTS=true
MIRROR_SELECTED_TO_DRIVE=true
MIRROR_FINAL_TO_DRIVE=true
MIRROR_REJECTED_TO_DRIVE=false

# ---------- Safety ----------
AUTO_PUBLISH=false
REQUIRE_HUMAN_QC=true
